# Primary Gemini API key (required; used as fallback for any phase without its own key)
GEMINI_API_KEY=your-primary-gemini-api-key-here

# Phase 1: per-chunk tool extraction (optional - falls back to GEMINI_API_KEY)
GEMINI_API_KEY_EXTRACT=your-phase-1-gemini-api-key-here

# Phase 3: field_tools categorisation (optional - falls back to GEMINI_API_KEY)
GEMINI_API_KEY_FIELDS=your-phase-3-gemini-api-key-here

SPREADSHEET_ID=your-google-sheet-id-here
